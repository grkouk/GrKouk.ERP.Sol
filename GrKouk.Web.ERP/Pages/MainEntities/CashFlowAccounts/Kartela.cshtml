@page
@using GrKouk.Web.ERP.Helpers
@model GrKouk.Web.ERP.Pages.MainEntities.CashFlowAccounts.KartelaModel
@{
    ViewData["Title"] = "Καρτέλα" + @Model.CfaName;
}
@section MyCss
    {
    <link rel="stylesheet" href="~/css/custom-checkbox.css" />
    <link rel="stylesheet" href="~/css/searchbar.css" />
}
<input type="hidden" id="initialPageTitle" value="@ViewData["Title"]" />
<h4 id="hElementTitle">@ViewData["Title"]</h4>
<div class="container ">
    <ul class="nav small justify-content-end ">

        <li class="nav-item">
            <a class="nav-link" data-toggle="collapse" href="#filterCollapse" role="button" id="filtersToggle"
                aria-expanded="false" aria-controls="filterCollapse">
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="collapse" href="#" id="rowSelectorsToggle" role="button">

            </a>
        </li>
        <li class="nav-item dropdown " id="SelectedRowsActionsMenu">
            <a class="nav-link dropdown-toggle disabled" role="button" id="ddSelectedRowsActions" data-toggle="dropdown"
                aria-haspopup="true" aria-expanded="false">Actions</a>
            <div class="dropdown-menu small">

                <a class="dropdown-item" href="#">Another action</a>
                <a class="dropdown-item" href="#">Something else here</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="#">Separated link</a>

            </div>
        </li>
    </ul>
</div>
<input type="hidden" asp-for="CfaId" />
@await Component.InvokeAsync("IndexFilters", new IndexFiltersToShow { ShowDateFlt = true ,ShowDisplayCarryOnLineFlt =
    true, ShowCompaniesMultiFlt = true, ShowCompaniesFlt = false})


<div class="row mt-1">
    <partial name="_PagerPartial" />
</div>
<partial name="_DataTable" />
<div class="row">
    <partial name="_PagerPartial" />
</div>
<br />

<a asp-page="./Index" class="small">Back to List</a>
<partial name="_LoadMePartial" />


@section Scripts
{
    <script src="https://cdn.syncfusion.com/ej2/28.1.37/dist/ej2.min.js"></script>
    <ejs-scripts></ejs-scripts>
        @* <script src="~/js/moment.min.js"></script> *@
        <script src="~/js/moment-with-locales.min.js"></script>
    <script src="~/js/definitions.js"></script>
    <script src="~/js/filterManagement.lib.js"></script>
    <script src="~/js/indexPageIIFE.lib.js"></script>
    <script>
        $(document).ready(function () {
            const storageKey = 'CashFlowAccountTabNew';
            const elementSettingsConfig = {
                // Element ID: { key: storageKey, default: defaultValue, prop: propertyToSetOrRead }
                // 'pageIndex':                 { key: 'pageIndex',                 default: 1,           prop: 'value' },
                'PageSize':                  { key: 'pageSize',                  default: 10,          prop: 'value' },
                'filtersVisible':            { key: 'filtersVisible',            default: true,        prop: 'value' },
                'rowSelectorsVisible':       { key: 'rowSelectorsVisible',       default: false,       prop: 'value' },
                'DatePeriodFilter':          { key: 'dateRangeFilter',           default: 'CURYEAR',   prop: 'value' },
                //'CompanyFilter':             { key: 'companyFilter',             default: 0,           prop: 'value' },
                'CompaniesFilter': {key: 'companiesFilter', default: '[0]', prop: 'value', dataType: 'array'},
                //  'TransactorTypeFilter':      { key: 'transactorTypeFilter',      default: 1,           prop: 'value' },
                //'WarehouseItemNatureFilter': { key: 'warehouseItemNatureFilter', default: 1,           prop: 'value' },
                'currentSort':               { key: 'currentSort',               default: 'datesort:asc',prop: 'value' },
                'CurrencySelector':          { key: 'currentCurrency',           default: 1,          prop: 'value' },
                'ShowCarryOnFlt':            { key: 'ShowCarryOnFlt',            default: true,        prop: 'checked'} // Reads the 'checked' property
            };
            // --- Page Hide Event Listener (Replaces unload) ---
            window.addEventListener('pagehide', function(event) {
                console.log('pagehide event triggered. Saving settings...'); // For debugging
                indPgLib.saveSettingsToStorage(storageKey, elementSettingsConfig);
                // Avoid complex logic or async operations here
            });
            document.addEventListener('visibilitychange', function() {
                if (document.visibilityState === 'hidden') {
                    console.log('visibilitychange to hidden triggered. Saving settings...'); // For debugging
                    saveSettingsToStorage(storageKey, elementSettingsConfig);
                }
            });

            window.addEventListener('beforeunload', function(event) {
                console.log('beforeunload event triggered. Saving settings...'); // For debugging
                saveSettingsToStorage(storageKey, elementSettingsConfig);
                // DO NOT try to add confirmation dialogs or complex logic here.
            });
            var currentCulture = '@System.Globalization.CultureInfo.CurrentCulture';
            var formatterCurrency = new Intl.NumberFormat(currentCulture,
                {
                    style: 'currency',
                    currency: 'EUR',
                    minimumFractionDigits: 2
                });
            var formatterNumber = new Intl.NumberFormat(currentCulture,
                {
                    maximumFractionDigits: 3

                });
            //#region variables

            var currencyListJs = @Html.Raw(Json.Serialize(ViewBag.CurrencyListJs));
            //#endregion
            //#region Index page definition objects
            const colDefs = [
                {
                    key: 'transDate',
                    responseKey: 'transDate',
                    actualVal: '',
                    columnFormat: 'd',
                    totalKey: '',
                    grandTotalKey: '',
                    totalFormatter: '',
                    sortKey: 'DateSort',
                    sortType: 'numeric',
                    header: 'Date',
                    text: '',
                    headerClass: 'small text-center ',
                    class: 'small',
                    classWhenCondition: '',
                    classCondition: {},
                    remoteReference: {
                    }
                },
                {
                    key: 'docSeriesName',
                    responseKey: 'docSeriesName',
                    actualVal: '',
                    columnFormat: 't',
                    totalKey: '',
                    grandTotalKey: '',
                    totalFormatter: '',
                    sortKey: 'SeriesNameSort',
                    sortType: 'alpha',
                    header: 'Series',
                    text: '',
                    headerClass: 'small text-center',
                    class: 'small',
                    classWhenCondition: '',
                    classCondition: {},
                    remoteReference: {
                    }
                },
                {
                    key: 'refCode',
                    responseKey: 'refCode',
                    actualVal: '',
                    columnFormat: 't',
                    totalKey: '',
                    grandTotalKey: '',
                    totalFormatter: '',
                    sortKey: '',
                    sortType: '',
                    header: 'Ref Number',
                    text: '',
                    headerClass: 'small text-center d-none d-md-table-cell',
                    class: 'small d-none d-md-table-cell ',
                    classWhenCondition: '',
                    classCondition: {},
                    remoteReference: {
                    }
                },
                {
                    key: 'deposit',
                    responseKey: 'deposit',
                    actualVal: '',
                    columnFormat: 'c',
                    totalKey: 'sumOfDebit',
                    grandTotalKey: 'grandSumOfDebit',
                    totalFormatter: 'currency',
                    sortKey: '',
                    sortType: '',
                    header: 'Deposit',
                    text: '',
                    headerClass: 'small text-center',
                    class: 'small text-end ',
                    classWhenCondition: '',
                    classCondition: {},
                    remoteReference: {
                    }
                },
                {
                    key: 'withdraw',
                    responseKey: 'withdraw',
                    actualVal: '',
                    columnFormat: 'c',
                    totalKey: 'sumOfCredit',
                    grandTotalKey: 'grandSumOfCredit',
                    totalFormatter: 'currency',
                    sortKey: '',
                    sortType: '',
                    header: 'Withdraw',
                    text: '',
                    headerClass: 'small text-center',
                    class: 'small text-end ',
                    classWhenCondition: '',
                    classCondition: {},
                    remoteReference: {
                    }
                },
                {
                    key: 'runningTotal',
                    responseKey: 'runningTotal',
                    actualVal: '',
                    columnFormat: 'c',
                    totalKey: '',
                    grandTotalKey: '',
                    totalFormatter: 'currency',
                    sortKey: '',
                    sortType: '',
                    header: 'Running Total',
                    text: '',
                    headerClass: 'small text-center',
                    class: 'small text-end ',
                    classWhenCondition: '',
                    classCondition: {},
                    remoteReference: {
                    }
                },
                {
                    key: 'companyCode',
                    responseKey: 'companyCode',
                    actualVal: '',
                    columnFormat: 't',
                    totalKey: '',
                    grandTotalKey: '',
                    totalFormatter: '',
                    sortKey: 'CompanyCodeSort',
                    sortType: 'alpha',
                    header: 'Company',
                    text: '',
                    headerClass: 'small text-center',
                    class: 'small ',
                    classWhenCondition: '',
                    classCondition: {},
                    remoteReference: {
                    }
                }
            ];
            const actionColDefs = [
                {
                    actionType: 'defaultAction2',
                    visibility: 'always',
                    target: '_blank',
                    condition: {},
                    text: 'Edit Prototype',

                    dataAttributes: [
                        {
                            key: 'docid',
                            valueKey: 'docid'
                        }
                    ],
                    icon: '<i class="fas fa-edit fa-lg" style="color:slategray"></i>',
                    uriType: 'funcHref', //funcUrl staticHref, staticUrl
                    urlKeys: [
                        { key: 'id', valueKey: 'id' }
                    ],
                    uriFunc: function (col, valueSource) {
                        let retUri = '';
                        if (valueSource.creatorSectionId > 0) {
                            switch (valueSource.creatorSectionCode) {
                                case "SCNSELLCOMBINED":
                                    retUri = `/transactions/sellmaterialdoc/Edit?id=${valueSource["creatorId"]}`;
                                    break;
                                case "SCNBUYMATTRANS":
                                    retUri = `/transactions/buymaterialsdoc/Details?id=${valueSource["creatorId"]}`;
                                    break;
                                default:
                            }

                        } else {

                            var itemId = valueSource["id"];
                            retUri = `/transactions/CFATransactions/Details?id=${itemId}`;
                        }
                        return retUri;
                    },
                    uri: ''
                }
            ];
            const actionColSubDefs = [

            ];
            const actionMobileColDefs = [
                {
                    actionType: 'defaultAction2',
                    visibility: 'always',
                    target: '_blank',
                    condition: {},
                    text: 'Edit Prototype',

                    dataAttributes: [
                        {
                            key: 'docid',
                            valueKey: 'docid'
                        }
                    ],
                    icon: '<i class="fas fa-edit fa-lg" style="color:slategray"></i>',
                    uriType: 'funcHref', //funcUrl staticHref, staticUrl
                    urlKeys: [
                        { key: 'id', valueKey: 'id' }
                    ],
                    uriFunc: function (col, valueSource) {
                        let retUri = '';
                        if (valueSource.creatorSectionId > 0) {
                            switch (valueSource.creatorSectionCode) {
                                case "SCNSELLCOMBINED":
                                    retUri = `/transactions/sellmaterialdoc/Edit?id=${valueSource["creatorId"]}`;
                                    break;
                                case "SCNBUYMATTRANS":
                                    retUri = `/transactions/buymaterialsdoc/Edit?id=${valueSource["creatorId"]}`;
                                    break;
                                default:
                            }

                        } else {

                            var itemId = valueSource["id"];
                            retUri = `/transactions/CFATransactions/Edit?id=${itemId}`;
                        }
                        return retUri;
                    },
                    uri: ''
                }
            ];
            const tableHandlersToRegister = [

            ];
            const pageHandlersToRegister = [
                {
                    selector: '#CurrencySelector',
                    event: 'change',
                    handler: function (event) {
                        currencyChanged();
                        indPgLib.refreshData();
                    }
                },
                {
                    selector: '#ShowCarryOnFlt',
                    event: 'change',
                    handler: function (event) {

                        indPgLib.refreshData();
                    }
                
                }
            ];
            const indexPageDef = {
                uri: '/api/GrKoukInfoApi/GetIndexTblDataCfaAccountTab',
                currencyFormatter: formatterCurrency,
                numberFormatter: formatterNumber,
                colDefs: colDefs,
                actionColDefs: actionColDefs,
                actionColSubDefs: actionColSubDefs,
                actionMobileColDefs: actionMobileColDefs,
                tableHandlersToRegister: tableHandlersToRegister,
                pageHandlersToRegister: pageHandlersToRegister,
                afterTableLoad: {
                }
            };

            indPgLib.setIndexPageDefinition(indexPageDef);
            //#endregion
            var currencyChanged = () => {
                let curCurrencySelected = parseInt($('#CurrencySelector').val());
                var currencyCode;
                try {
                    let currentCurrency = currencyListJs.find(x => x.id === curCurrencySelected);
                    currencyCode = currentCurrency.code;
                    let locale = currentCurrency.displayLocale;
                    formatterCurrency = new Intl.NumberFormat(locale,
                        {
                            style: 'currency',
                            currency: currencyCode,
                            minimumFractionDigits: 2
                        });
                    indPgLib.setCurrencyFormatter(formatterCurrency);
                } catch (e) {
                    //not found keep old formater or maybe create a default one
                    console.log('Not found currency code for this id');
                }
            };

            indPgLib.addPagerElementEventListeners();
            indPgLib.registerPageHandlers();
            //Going to new setting management
            indPgLib.applySettingsFromStorage(storageKey,elementSettingsConfig);
            //----------------
            indPgLib.handleFiltersUi();
            //--------------------------Companies filter handling
            const selectedCompanies = document.getElementById("CompaniesFilterElm").ej2_instances[0];
            let companiesFilterValue = $('#CompaniesFilter').val();
            if (companiesFilterValue != null && companiesFilterValue.length > 0) {
                selectedCompanies.value = JSON.parse(companiesFilterValue);
            }
            selectedCompanies.changeOnBlur = false;
            selectedCompanies.addEventListener("change", (event) => {
                // Ensure we have arrays, even if null/undefined
                const newValue = event.value || [];
                const oldValue = event.oldValue || []; // Assumes your component provides oldValue

                const zeroWasSelected = oldValue.includes(0);
                const zeroIsSelected = newValue.includes(0);

                let finalValue; // This will hold the calculated correct selection

                // --- Rule 1: User just selected 0 ---
                // Check if 0 is newly added in this change event
                if (zeroIsSelected && !zeroWasSelected) {
                    finalValue = [0]; // Force selection to be only 0
                }
                    // --- Rule 2: User selected something else while 0 was selected ---
                // Check if 0 was selected before, AND a non-zero item was added
                else if (zeroWasSelected) {
                    // Find items present in newValue but not in oldValue
                    const addedItems = newValue.filter(item => !oldValue.includes(item));
                    // Check if any of those newly added items are not 0
                    const addedNonZeroItem = addedItems.some(item => item !== 0);

                    if (addedNonZeroItem) {
                        // User added a non-zero item while 0 was selected. Remove 0.
                        finalValue = newValue.filter(item => item !== 0);
                    } else {
                        // 0 was selected, but only other changes happened (like removing items, or removing 0 itself).
                        // In this case, the component's newValue is likely correct as is (it might be just [0], or [] etc.)
                        finalValue = newValue;
                    }
                }
                // --- Default Case: No special 0-rule applies ---
                else {
                    // 0 wasn't selected before, and wasn't added now. Normal selection.
                    finalValue = newValue;
                }

                // --- Update Component and Hidden Field ---

                // Get the component's current visual value (might differ from finalValue if we intervened)
                const currentComponentValue = selectedCompanies.value || [];

                // Check if our calculated finalValue is different from the component's current value
                // Simple array comparison for primitive values:
                const valuesAreEqual = finalValue.length === currentComponentValue.length &&
                    finalValue.every((val, index) => val === currentComponentValue[index]);

                // Only update the component's value if it needs changing, prevents potential event loops
                if (!valuesAreEqual) {
                    selectedCompanies.value = finalValue;
                }

                // Always update the hidden input field with the final calculated value
                $('#CompaniesFilter').val(JSON.stringify(finalValue));
            });
            selectedCompanies.addEventListener("blur", (event) => {
                const allCompaniesId = 0;
                if (selectedCompanies.value == null || selectedCompanies.value.length === 0) {
                    selectedCompanies.value = [allCompaniesId];
                }

                indPgLib.refreshData();
            });
            selectedCompanies.addEventListener("close", (event) => {
                indPgLib.refreshData();
            });
            //---------------------------------------------------
            currencyChanged();
            indPgLib.refreshData();
            indPgLib.rowSelectorsUi();
        });

        
    </script>
    @ScriptHelper.RenderScripts(HttpContext)
}
