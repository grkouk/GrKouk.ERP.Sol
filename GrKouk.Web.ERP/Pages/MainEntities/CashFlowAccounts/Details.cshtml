@page
@using GrKouk.Web.ERP.Helpers
@model GrKouk.Web.Erp.Pages.MainEntities.CashFlowAccounts.DetailsModel

@{
    Layout = "_LayoutDashboard";
    //ViewData["Title"] = "Product Details";
}

<input type="hidden" id="initialPageTitle" value="Financial Summary"/>
<div class="container-fluid">
    <div class="row">
        <main role="main" class="col-md-12 ms-sm-auto col-lg-12 px-4">
            @await Component.InvokeAsync("DetailFilters", new DetailFiltersToShow { ShowDateFlt = true, ShowCurrencyFlt = true, ShowCompaniesMultiFlt = true })
            <div class="container">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@Model.ItemVm.Code</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@Model.ItemVm.Companies</h6>
                        <p class="card-text"></p>
                        <a href="./kartela?cashFlowAccountId=@Model.ItemVm.Id" class="card-link"
                           target="_blank">Καρτέλα</a>
                        <a href="#" class="card-link">Another link</a>
                    </div>
                </div>
            </div>

            <hr/>
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-2 mb-3 border-bottom">
                <div class="d-flex align-items-center">
                    <h5 id="hElementTitle" class="me-2">Financial Summary</h5>
                    <div class="spinner-border ml-auto text-primary" role="status" aria-hidden="true"
                         id="FinancialLoader" style="display: none"></div>
                </div>

            </div>
            <div class="container">
                <div class="row align-items-center justify-content-between">
                    <div class="col-lg-4 col-sm-12">
                        <div class="card">
                            <div class="card-header text-center">
                                <h5>Εισροές</h5>
                            </div>
                            <div class="card-body text-center">
                                <table class="table-sm w-100">

                                    <tr>
                                        <td>Αξία(Εισροών)</td>
                                        <td>

                                            <span class="currency-data" name="ImportValue"></span>
                                        </td>
                                    </tr>

                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-sm-12">
                        <div class="card">
                            <div class="card-header text-center">
                                <h5>Εκροές</h5>
                            </div>
                            <div class="card-body text-center">
                                <table class="table-sm w-100">

                                    <tr>
                                        <td>Αξία(Εκροών)</td>
                                        <td><span class="currency-data" name="ExportValue"></span></td>
                                    </tr>


                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-sm-12">
                        <div class="card">
                            <div class="card-header text-center">
                                <h5>Balance</h5>
                            </div>
                            <div class="card-body text-center">
                                <table class="table-sm w-100">

                                    <tr>
                                        <td>Αξία</td>
                                        <td><span class="currency-data" name="ValueBalance"></span></td>
                                    </tr>

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h5>Transactions</h5>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary">Share</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn  btn-sm btn-outline-secondary selected-period-text">Reference
                        </button>
                        <button type="button"
                                class="btn  btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split"
                                id="datePeriodMenuReference" data-bs-toggle="dropdown" aria-haspopup="true"
                                aria-expanded="false" data-reference="parent">
                            <span class="sr-only">Toggle Dropdown</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="datePeriodMenuReference"
                             name="PeriodSelector">
                            <button class="dropdown-item period-item" type="button">Action</button>
                            <button class="dropdown-item period-item" type="button">Another Action</button>

                            <button class="dropdown-item period-item" type="button">Another Action</button>
                        </div>
                    </div>

                </div>
            </div>


            <div id="transGrid">
                <input type="hidden" asp-for="ItemVm.Id" id="CashFlowAccountId"/>
                <input type="hidden" id="SelectedCompanies"/>
                <input type="hidden" id="CurrencyId"/>
                <input type="hidden" id="PeriodId"/>
                <input type="hidden" id="companiesSelectionChanged"/>
                <ejs-grid id="GridCFADetailPage"
                          allowPaging="true" allowResizing="true" allowSorting="true" enablePersistence="true">
                    <e-grid-loadingindicator indicatorType="Spinner"/>
                    <e-data-manager url="@Url.Action("GetCashFlowAccountTransactionsForDetail", "FinancialData")"
                                    adaptor="UrlAdaptor"></e-data-manager>
                    <e-grid-aggregates>
                        <e-grid-aggregate>
                            <e-aggregate-columns>
                                <e-aggregate-column field="deposit" type="Sum" format="C2"
                                                    footerTemplate="${Sum}"></e-aggregate-column>
                                <e-aggregate-column field="withdraw" type="Sum" format="C2"
                                                    footerTemplate="${Sum}"></e-aggregate-column>

                            </e-aggregate-columns>

                        </e-grid-aggregate>
                    </e-grid-aggregates>
                    <e-grid-pagesettings pageSizes="true"></e-grid-pagesettings>
                    <e-grid-columns>
                        <e-grid-column field="transDate" headerText="Trans Date" textAlign="Right" width="50"
                                       type="date" format="dd/MM/yyyy"></e-grid-column>
                        <e-grid-column field="docSeriesCode" headerText="Series Code" width="60"></e-grid-column>
                        <e-grid-column field="refCode" headerText="Ref Code" width="60"
                                       textAlign="Right"></e-grid-column>
                        <e-grid-column field="companyCode" headerText="Company Code" width="60"></e-grid-column>
                        <e-grid-column field="deposit" headerText="Deposit" width="50" type="number" textAlign="Right"
                                       format="C2"></e-grid-column>
                        <e-grid-column field="withdraw" headerText="Withdrawal" width="50" type="number"
                                       textAlign="Right" format="C2"></e-grid-column>
                        <e-grid-column field="runningTotal" headerText="Running Total" type="number" width="50"
                                       textAlign="Right" format="C2"></e-grid-column>
                    </e-grid-columns>
                </ejs-grid>

            </div>

            <hr/>
            <footer>
                <p>&copy; 2018-2025 - George Koukoudis</p>
            </footer>

        </main>
    </div>
</div>

@section Scripts
{
    <script src="~/js/filterManagement.lib.js"></script>
    <script src="~/js/product.lib.js"></script>
    <script>
        $(document).ready(function () {
            const storageKey = 'CashFlowAccountDetailsPageNew';
            const elementSettingsConfig = {
                // Element ID: { key: storageKey, default: defaultValue, prop: propertyToSetOrRead }
                'DatePeriodFilter': {key: 'dateRangeFilter', default: 'CURYEAR', prop: 'value'},
                'CurrencySelector': {key: 'currentCurrency', default: 1, prop: 'value'},
                //'CompanyFilter':             { key: 'companyFilter',             default: 0,           prop: 'value' },
                'CompaniesFilter': {key: 'companiesFilter', default: '[0]', prop: 'value', dataType: 'array'},
                'fromDateFilterEl': {key: 'fromDateFilter', default: '', prop: 'value'},
                'toDateFilterEl': {key: 'toDateFilter', default: '', prop: 'value'},
            };
            window.addEventListener('beforeunload', function (event) {
                console.log('beforeunload event triggered. Saving settings...'); // For debugging
                fltManLib.saveSettingsToStorage(storageKey, elementSettingsConfig);
                // DO NOT try to add confirmation dialogs or complex logic here.
            });
            const $companiesFilterEl = $('#CompaniesFilterElm');
            const $spinnerEl = $('#FinancialLoader');
            const $currencySelector = $('#CurrencySelector');
            const $companiesSelectionChanged = $('#companiesSelectionChanged');
            const $periodSelector = $('#DatePeriodFilter');
            //const $periodSelectionChanged = $('#companiesSelectionChanged');
            const allCompaniesId = @ViewBag.AllCompaniesId;
            //const sessionKey = 'TransactorDetailsPageNew';
            let currentCulture = '@System.Globalization.CultureInfo.CurrentCulture';

            let formatterCurrency = new Intl.NumberFormat(currentCulture,
                {
                    style: 'currency',
                    currency: 'EUR',
                    minimumFractionDigits: 2
                });
            let formatterNumber = new Intl.NumberFormat(currentCulture,
                {
                    maximumFractionDigits: 3

                });
            const loadCultureFiles = (name) => {
                let files = ['ca-gregorian.json', 'numbers.json', 'timeZoneNames.json', 'currencies.json'];
                if (name === 'ar') {
                    files.push('numberingSystems.json');
                }
                let loader = ej.base.loadCldr;
                let loadCulture = function (prop) {
                    let val
                    let ajax;
                    if (name === 'ar' && prop === files.length - 1) {
                        ajax = new ej.base.Ajax(location.origin + location.pathname + '/../../../lib/cldr-data/supplemental/' + files[prop], 'GET', false);
                    } else {
                        ajax = new ej.base.Ajax(location.origin + location.pathname + '/../../../lib/cldr-data/main/' + name + '/' + files[prop], 'GET', false);
                    }
                    ajax.onSuccess = function (value) {
                        val = value;
                    };
                    ajax.send();
                    loader(JSON.parse(val));
                };
                for (var prop = 0; prop < files.length; prop++) {
                    loadCulture(prop);
                }
            };
            const loadCultureFiles1 = (culture) => {
                let files = ['ca-gregorian.json', 'currencies.json', 'timeZoneNames.json', 'numbers.json'];
                if (culture === 'ar') {
                    files.push('numberingSystems.json');
                }
                const loader = ej.base.loadCldr;
                const loadCulture = function (prop) {
                    let fetch;
                    if (culture === 'ar' && prop === files.length - 1) {
                        fetch = new ej.base.Fetch(location.origin + location.pathname + '/../../../lib/cldr-data/supplemental/' + files[prop], 'GET', false);
                    } else {
                        fetch = new ej.base.Fetch(location.origin + location.pathname + '/../../../lib/cldr-data/main/' + culture + '/' + files[prop], 'GET', false);
                    }
                    //fetch = new ej.base.Fetch(location.origin + location.pathname + '/../../../lib/cldr-data/main/' + culture + '/' + files[prop], 'GET', false);
                    fetch.onSuccess = function (response) {
                        if (typeof response === 'object') {
                            // If the response is an object, convert it to a JSON string
                            var jsonString = JSON.stringify(response);
                            loader(JSON.parse(jsonString));
                        } else if (typeof response === 'string') {
                            // If the response is already a JSON string, parse and load it
                            loader(JSON.parse(response));
                        } else {
                            console.error('Invalid responsetype received:', response);
                        }

                    };
                    fetch.send();
                };
                for (var prop = 0; prop < files.length; prop++) {
                    loadCulture(prop);
                }
            };
           
            const selectedCompanies = document.getElementById("CompaniesFilterElm").ej2_instances[0];
            let companiesFilterValue = $('#CompaniesFilter').val();
            if (companiesFilterValue != null && companiesFilterValue.length > 0) {
                selectedCompanies.value = JSON.parse(companiesFilterValue);
            }
            selectedCompanies.changeOnBlur = false;
            selectedCompanies.addEventListener("change", (event) => {
                let a = allCompaniesId;
                // Ensure we have arrays, even if null/undefined
                const newValue = event.value || [];
                const oldValue = event.oldValue || []; // Assumes your component provides oldValue

                const zeroWasSelected = oldValue.includes(allCompaniesId);
                const zeroIsSelected = newValue.includes(allCompaniesId);

                let finalValue; // This will hold the calculated correct selection

                // --- Rule 1: User just selected 0 ---
                // Check if 0 is newly added in this change event
                if (zeroIsSelected && !zeroWasSelected) {
                    finalValue = [allCompaniesId]; // Force selection to be only 0
                }
                    // --- Rule 2: User selected something else while 0 was selected ---
                // Check if 0 was selected before, AND a non-zero item was added
                else if (zeroWasSelected) {
                    // Find items present in newValue but not in oldValue
                    const addedItems = newValue.filter(item => !oldValue.includes(item));
                    // Check if any of those newly added items are not 0
                    const addedNonZeroItem = addedItems.some(item => item !== allCompaniesId);

                    if (addedNonZeroItem) {
                        // User added a non-zero item while 0 was selected. Remove 0.
                        finalValue = newValue.filter(item => item !== allCompaniesId);
                    } else {
                        // 0 was selected, but only other changes happened (like removing items, or removing 0 itself).
                        // In this case, the component's newValue is likely correct as is (it might be just [0], or [] etc.)
                        finalValue = newValue;
                    }
                }
                // --- Default Case: No special 0-rule applies ---
                else {
                    // 0 wasn't selected before, and wasn't added now. Normal selection.
                    finalValue = newValue;
                }

                // --- Update Component and Hidden Field ---

                // Get the component's current visual value (might differ from finalValue if we intervened)
                const currentComponentValue = selectedCompanies.value || [];

                // Check if our calculated finalValue is different from the component's current value
                // Simple array comparison for primitive values:
                const valuesAreEqual = finalValue.length === currentComponentValue.length &&
                    finalValue.every((val, index) => val === currentComponentValue[index]);

                // Only update the component's value if it needs changing, prevents potential event loops
                if (!valuesAreEqual) {
                    selectedCompanies.value = finalValue;
                }

                // Always update the hidden input field with the final calculated value
                $('#CompaniesFilter').val(JSON.stringify(finalValue));
            });
            selectedCompanies.addEventListener("close", (event) => {
                refreshView();

            });

            const currencyListJs = @Html.Raw(Json.Serialize(ViewBag.CurrencyListJs));
            const mainEntityId = @Model.ItemVm.Id;
            const refreshView = () => {
                let selPeriodId = $periodSelector.val();
                let selCurrencyId = $currencySelector.val();
                let selCompanies;
                let companiesFilterValue = $('#CompaniesFilter').val();
                if (companiesFilterValue != null && companiesFilterValue.length > 0) {
                    selCompanies = companiesFilterValue;
                }
                let fromCustomDate='';
                let toCustomDate='';
                let $toCustomFilterDate = $("#toDateFilterEl");
                if ($toCustomFilterDate.val() != null && $toCustomFilterDate.val().length > 0) {
                    toCustomDate = $toCustomFilterDate.val();
                }
                let $fromCustomFilterDate = $("#fromDateFilterEl");
                if ($fromCustomFilterDate.val() != null && $fromCustomFilterDate.val().length > 0) {
                    fromCustomDate = $fromCustomFilterDate.val();
                }
                getFinancialData(mainEntityId, selPeriodId, selCompanies, selCurrencyId,fromCustomDate,toCustomDate, $spinnerEl)
                fltManLib.setIndexViewTitlesBasedOnPeriod();
                let grd = document.getElementById("GridCFADetailPage").ej2_instances[0];
                grd.query = new ej.data.Query()
                    .addParams('entityId', mainEntityId)
                    .addParams('dateRange', selPeriodId)
                    .addParams('companyFilter', selCompanies)
                    .addParams('displayCurrencyId', selCurrencyId)
                    .addParams('fromCustomFilterDate', fromCustomDate)
                    .addParams('toCustomFilterDate', toCustomDate);
            };
            window.refreshData = refreshView;
            const formatNumericElements = () => {
                let $currencyElements = $('.currency-data');
                let $numElements = $('.numeric-data');
                $currencyElements.each(function () {
                    let $el = $(this);
                    //let elValueStr = $el.attr('data-actualValue');
                    let elValueStr = $el.text();
                    let elValue = parseFloat(elValueStr);
                    if (!isNaN(elValue)) {
                        $el.text(formatterCurrency.format(elValue));
                    }

                });
                $numElements.each(function () {
                    let $el = $(this);
                    //let elValueStr = $el.attr('data-actualValue');
                    let elValueStr = $el.text();
                    let elValue = parseFloat(elValueStr);
                    if (!isNaN(elValue)) {
                        $el.text(formatterNumber.format(elValue));
                    }

                });
            };
            const getSelectedCurrencyId = (selector, val) => {
                // Check if the value is null or undefined
                if (val == null) {
                    // Find the first option element within the select
                    let firstOption = selector.find('option:first');
                    if (firstOption.length > 0) { // Check if a first option actually exists
                        firstOption.prop('selected', true); // Select the first option
                        val = selector.val(); // Get the value of the newly selected first option
                        // Optional: If other parts of your code react to changes, trigger the change event
                        // selector.trigger('change');
                    } else {
                        // Handle the case where the select element has no options
                        console.warn("CurrencySelector select element has no options.");
                        // Decide what curCurrencySelected should be in this case, e.g., NaN, 0, or null
                        val = null;
                    }
                }
                // Now, parse the value. Handle the case where val might still be null (if select was empty).
                let curCurrencySelected = val != null ? parseInt(val) : NaN;
                return curCurrencySelected;
            };
            const currencyChanged = () => {
                let selector = $('#CurrencySelector'); // Get the selector once for efficiency
                let val = selector.val(); // Get the current value
                let curCurrencySelected = getSelectedCurrencyId(selector, val);
                let currencyCode;
                try {
                    let currentCurrency = currencyListJs.find(x => x.id === curCurrencySelected);
                    currencyCode = currentCurrency.code;
                    let locale = currentCurrency.displayLocale;
                    formatterCurrency = new Intl.NumberFormat(locale,
                        {
                            style: 'currency',
                            currency: currencyCode,
                            minimumFractionDigits: 2
                        });
                    formatterNumber = new Intl.NumberFormat(locale,
                        {
                            maximumFractionDigits: 3

                        });
                    let cCulture = locale;
                    let cBaseCulture = cCulture;
                    if (cCulture.length > 2) {
                        cBaseCulture = cCulture.substring(0, 2);
                    }
                    loadCultureFiles(cBaseCulture);
                    ej.base.setCulture(cBaseCulture);
                    ej.base.setCurrencyCode(currencyCode);
                    //loadEj2Translation(cBaseCulture);

                    var grid = document.getElementById("GridCFADetailPage").ej2_instances[0];
                    grid.locale = cBaseCulture;
                    refreshView();
                    //formatNumericElements();
                    //indPgLib.setCurrencyFormatter(formatterCurrency);
                } catch (e) {
                    //not found keep old formater or maybe create a default one
                    console.log('Not found currency code for this id');
                }
            };

          
            const getFinancialData = (itemId, dateRange, selCompany, selCurrency, fromCustomDate, toCustomDate, spinnerEl) => {
                productLib.getCfaFinancialSummaryData(itemId, dateRange, selCompany, selCurrency, fromCustomDate, toCustomDate, spinnerEl)
                    .then((data) => {
                        console.log(data);

                        let $importValue = $('[name=ImportValue]');

                        let $exportValue = $('[name=ExportValue]');
                        let $valueBalance = $('[name=ValueBalance]');

                        $importValue.text(data.sumOfDeposits);


                        $exportValue.text(data.sumOfWithdraws);

                        $valueBalance.text(data.sumOfDifference);
                        formatNumericElements();
                    })
                    .catch((error) => {
                        console.log("Error getting summary data");
                        console.log(error);
                    });
            };
            $currencySelector.change((event) => {
                currencyChanged();
            });
            const periodChanged = () => {
                refreshView();
            };
            $periodSelector.change((event) => {
                periodChanged();
            });
            fltManLib.applySettingsFromStorage(storageKey, elementSettingsConfig);


            companiesFilterValue = $('#CompaniesFilter').val();
            if (companiesFilterValue != null && companiesFilterValue.length > 0) {
                selectedCompanies.value = JSON.parse(companiesFilterValue);
            }

            var selected = JSON.stringify(selectedCompanies.value);

            currencyChanged();
        });
       
    </script>
    @ScriptHelper.RenderScripts(HttpContext)
}




