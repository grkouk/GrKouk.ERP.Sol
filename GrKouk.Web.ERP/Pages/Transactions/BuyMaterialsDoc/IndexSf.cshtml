@page
@using GrKouk.Web.ERP.Helpers.SfGrid
@model GrKouk.Web.ERP.Pages.Transactions.BuyMaterialsDoc.IndexSfModel

@{
    ViewData["Title"] = "Παραστατικά Αγορών/Εξόδων";
    ViewData["FluidContainer"] = true;
    var pageSizes = new[] { 10, 20, 50, 100 };
}

@section MyCss
{
    <link rel="stylesheet" href="~/css/searchbar.css" />
    <link rel="stylesheet" href="~/css/sf-index.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()
<h4>@ViewData["Title"]</h4>

<partial name="Sf/_SfIndexToolbar" model="@(new SfIndexToolbarModel { Diaries = Model.Diaries, DiaryPage = "./RunBuyDiary" })" />

<partial name="Sf/_SfIndexFilters" model="@(new SfIndexFiltersModel
{
    DatePeriodItems = Model.DatePeriodItems,
    CompanyItems = Model.CompanyFilterItems,
    CurrencyItems = Model.CurrencyItems
})" />

<ejs-grid id="BuyDocsGrid" allowPaging="true" allowSorting="true" allowMultiSorting="false"
          allowTextWrap="true" gridLines="Both" rowHeight="32" enableHtmlSanitizer="true"
          load="sfGridLoad" actionComplete="sfGridActionComplete" actionFailure="sfGridActionFailure"
          dataBound="sfGridDataBound" rowSelected="sfSelectionChanged" rowDeselected="sfSelectionChanged">
    <e-data-manager url="@Url.Page("./IndexSf", "DataSource")" adaptor="UrlAdaptor"></e-data-manager>
    <e-grid-selectionsettings type="Multiple" checkboxOnly="true" persistSelection="true"></e-grid-selectionsettings>
    <e-grid-pagesettings pageSize="10" pageSizes="@pageSizes"></e-grid-pagesettings>
    <e-grid-columns>
        <e-grid-column type="checkbox" width="40" visible="false"></e-grid-column>
        <e-grid-column field="id" isPrimaryKey="true" visible="false"></e-grid-column>
        <e-grid-column field="transDate" headerText="Date" width="125" template="#dateTemplate"></e-grid-column>
        <e-grid-column field="transactorName" headerText="Transactor" width="220"
                       template="#transactorTemplate"></e-grid-column>
        <e-grid-column field="buyDocSeriesCode" headerText="Series" width="100"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="transRefCode" headerText="Ref Number" width="120"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="paymentMethod" headerText="Τρ.Πληρωμής" width="120" allowSorting="false"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="companyCode" headerText="Company" width="90"></e-grid-column>
        <e-grid-column field="totalNetAmount" headerText="Net Amount" width="120" textAlign="Right"
                       allowSorting="false" valueAccessor="@("sfCurrencyAccessor")"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="totalAmount" headerText="Amount" width="120" textAlign="Right"
                       allowSorting="false" valueAccessor="@("sfCurrencyAccessor")"></e-grid-column>
        <e-grid-column field="payedOfAmount" headerText="Payed Amount" width="120" textAlign="Right"
                       allowSorting="false" valueAccessor="@("sfCurrencyAccessor")"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column headerText="" width="150" textAlign="Center" allowSorting="false"
                       template="#actionsTemplate"></e-grid-column>
    </e-grid-columns>
</ejs-grid>

<partial name="Sf/_SfTotalsBar" model="@(new SfTotalsBarModel
{
    Columns =
    {
        new SfTotalColumn("NetAmount", "Net Amount"),
        new SfTotalColumn("Amount", "Amount"),
        new SfTotalColumn("PayedAmount", "Payed Amount")
    }
})" />

<script id="dateTemplate" type="text/x-template">${transDateText}</script>

<script id="transactorTemplate" type="text/x-template">
    <a href="@Url.Page("/MainEntities/Transactors/Details")?id=${transactorId}">${transactorName}</a>
</script>

<script id="actionsTemplate" type="text/x-template">
    <a href="@Url.Page("./Edit")?id=${id}" title="Edit"><i class="fas fa-edit fa-lg" style="color:slategray"></i></a>
    <a href="@Url.Page("./Details")?id=${id}" title="Details" class="ms-2"><i class="fas fa-info-circle fa-lg" style="color:slategray"></i></a>
    <a href="@Url.Page("./Delete")?id=${id}" title="Delete" class="ms-2"><i class="fas fa-trash fa-lg" style="color:slategray"></i></a>
    <a href="@Url.Page("./Create")?copyFromId=${id}" title="Duplicate" class="ms-2"><i class="fas fa-clone fa-lg" style="color:slategray"></i></a>
    @* The Syncfusion template engine turns every "..." into '...', which would break the JSON in
       data-bs-popper-config; &quot; survives it and the browser decodes it back to ". *@
    <span class="dropdown ms-2">
        <a href="#" role="button" title="More" data-bs-toggle="dropdown" aria-expanded="false"
           data-bs-popper-config="{&quot;strategy&quot;:&quot;fixed&quot;}"><i class="fas fa-ellipsis-v fa-lg" style="color:slategray"></i></a>
        <span class="dropdown-menu dropdown-menu-end small">
            <a class="dropdown-item" target="_blank"
               href="@Url.Page("/Transactions/RecurringTransactions/Create")?createFromType=1&createFromId=${id}">
                <i class="fas fa-info-circle" style="color:slategray"></i> Νέα Συνδρομή
            </a>
            ${if(hasBalance)}
            <a class="dropdown-item" href="#" data-action="payoff" data-id="${id}">
                <i class="fab fa-amazon-pay" style="color:slategray"></i> Εξόφληση Παραστατικού
            </a>
            <a class="dropdown-item" href="#" data-action="assignPayments" data-id="${id}">
                <i class="fas fa-compress-arrows-alt" style="color:slategray"></i> Αντιστοίχιση Πληρωμών
            </a>
            ${/if}
        </span>
    </span>
</script>

<partial name="_DeleteConfirmationPartial" />

<partial name="Sf/_SfPaymentAssignModal" model="@(new SfPaymentAssignModalModel { Title = "Ευρετήριο Πληρωμών σε Προμηθευτή" })" />

@section Scripts
{
    <script src="https://cdn.syncfusion.com/ej2/dist/ej2.min.js"></script>
    <script src="~/js/sf-grid-fit.js" asp-append-version="true"></script>
    <script src="~/js/sf-index-page.js" asp-append-version="true"></script>
    <script src="~/js/sf-payment-assign.js" asp-append-version="true"></script>
    <script>
        // Runs before <ejs-scripts>: defines the grid and filter handlers the markup names.
        let payments;
        const sfIdx = sfIndexPage.create({
            gridId: 'BuyDocsGrid',
            storageKey: 'BuyDocIndexSf',
            culture: '@System.Globalization.CultureInfo.CurrentCulture.Name',
            defaults: { sortField: 'transDate', companyFilter: '0' },
            period: true,
            combos: [{ id: 'CompanyFilter', key: 'companyFilter' }],
            currencies: @Html.Raw(Json.Serialize(Model.CurrencyItems)),
            totalsUrl: '@Url.Page("./IndexSf", "Totals")',
            totals: [
                { key: 'NetAmount', field: 'totalNetAmount', grandField: 'netAmount' },
                { key: 'Amount', field: 'totalAmount', grandField: 'amount' },
                { key: 'PayedAmount', field: 'payedOfAmount', grandField: 'payedAmount' }
            ],
            deleteUrl: '@Url.Page("./IndexSf", "DeleteSelected")',
            deleteNoun: 'document(s)',
            loadErrorText: 'Could not load the documents',
            rowActions: {
                payoff: (id) => payments.payoff(id),
                assignPayments: (id) => payments.open(id)
            }
        });
    </script>
    <ejs-scripts></ejs-scripts>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            sfIdx.start();
            payments = sfPaymentAssign.create({
                page: sfIdx,
                listUrl: '/api/GrKoukInfoApi/GetSelectorPaymentsToSuppliersItems',
                saveUrl: '/api/Materials/AddBuyPaymentMappingList',
                payoffUrl: '/api/materials/AddBuyPaymentMapping',
                itemsNoun: 'payments'
            });
        });
    </script>
}
