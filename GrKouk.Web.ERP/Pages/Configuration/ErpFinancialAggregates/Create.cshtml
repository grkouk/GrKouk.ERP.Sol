@page
@model GrKouk.Web.Erp.Pages.Configuration.ErpFinancialAggregates.CreateModel

@{
    ViewData["Title"] = "Νέος Ορισμός Αθροιστικού";
}

<h4>Νέος Ορισμός Αθροιστικού</h4>
<hr/>

<div class="container">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="row mb-3">
            <div class="form-group col-md-4">
                <label asp-for="ItemVm.WarehouseItemNature" class="form-label small"></label>
                <select id="Nature" asp-for="ItemVm.WarehouseItemNature"
                        class="form-select form-select-sm"
                        asp-items="ViewBag.NatureList">
                    <option value="">-- Επιλογή --</option>
                </select>
                <span asp-validation-for="ItemVm.WarehouseItemNature" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="ItemVm.FpaDefId" class="form-label small"></label>
                <select id="FpaDef" asp-for="ItemVm.FpaDefId"
                        class="form-select form-select-sm"
                        asp-items="ViewBag.FpaDefList">
                    <option value="">-- Επιλογή --</option>
                </select>
                <span asp-validation-for="ItemVm.FpaDefId" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="ItemVm.WarehouseItemId" class="form-label small"></label>
                <select id="WarehouseItem" asp-for="ItemVm.WarehouseItemId"
                        class="form-select form-select-sm">
                    <option value="">-- Επιλέξτε πρώτα Φύση και ΦΠΑ --</option>
                </select>
                <span asp-validation-for="ItemVm.WarehouseItemId" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="form-group col-md-6">
                <label asp-for="ItemVm.Notes" class="form-label small"></label>
                <input asp-for="ItemVm.Notes" class="form-control form-control-sm"/>
            </div>
            <div class="form-group col-md-2 form-check mt-4">
                <input asp-for="ItemVm.Active" class="form-check-input"/>
                <label asp-for="ItemVm.Active" class="form-check-label small"></label>
            </div>
        </div>
        <div class="row mb-3">
            <div class="form-group">
                <input type="submit" value="Αποθήκευση" class="btn btn-secondary btn-sm"/>
                &nbsp;
                <a class="small" asp-page="Index">Πίσω</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            const nature = document.getElementById('Nature');
            const fpa = document.getElementById('FpaDef');
            const item = document.getElementById('WarehouseItem');

            async function reloadItems() {
                const n = nature.value, f = fpa.value;
                item.innerHTML = '<option value="">-- Επιλέξτε πρώτα Φύση και ΦΠΑ --</option>';
                if (!n || !f) return;
                const res = await fetch(`?handler=WarehouseItems&nature=${n}&fpaDefId=${f}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.length === 0) {
                    item.innerHTML = '<option value="">(Κανένα είδος με αυτόν τον συνδυασμό)</option>';
                    return;
                }
                item.innerHTML = '<option value="">-- Επιλογή --</option>' +
                    data.map(x => `<option value="${x.id}">${x.text}</option>`).join('');
            }

            nature.addEventListener('change', reloadItems);
            fpa.addEventListener('change', reloadItems);
        })();
    </script>
}
