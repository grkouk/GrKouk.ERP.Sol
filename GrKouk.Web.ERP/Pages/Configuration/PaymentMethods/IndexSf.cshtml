@page
@using GrKouk.Web.ERP.Helpers.SfGrid
@model GrKouk.Web.Erp.Pages.Configuration.PaymentMethods.IndexSfModel

@{
    ViewData["Title"] = "Τρόποι Πληρωμής";
    var pageSizes = new[] { 10, 20, 50, 100 };
}

@section MyCss
{
    <link rel="stylesheet" href="~/css/searchbar.css" />
    <link rel="stylesheet" href="~/css/sf-index.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()
<h4>@ViewData["Title"]</h4>

<partial name="Sf/_SfIndexToolbar" model="@(new SfIndexToolbarModel())" />

<partial name="Sf/_SfIndexFilters" model="@(new SfIndexFiltersModel
{
    CompanyItems = Model.CompanyFilterItems,
    ActiveItems = Model.ActiveFilterItems
})" />

<ejs-grid id="PaymentMethodsGrid" allowPaging="true" allowSorting="true" allowMultiSorting="false"
          allowTextWrap="true" gridLines="Both" rowHeight="32" enableHtmlSanitizer="true"
          load="sfGridLoad" actionComplete="sfGridActionComplete" actionFailure="sfGridActionFailure"
          dataBound="sfGridDataBound" rowSelected="sfSelectionChanged" rowDeselected="sfSelectionChanged">
    <e-data-manager url="@Url.Page("./IndexSf", "DataSource")" adaptor="UrlAdaptor"></e-data-manager>
    <e-grid-selectionsettings type="Multiple" checkboxOnly="true" persistSelection="true"></e-grid-selectionsettings>
    <e-grid-pagesettings pageSize="10" pageSizes="@pageSizes"></e-grid-pagesettings>
    <e-grid-columns>
        <e-grid-column type="checkbox" width="40" visible="false"></e-grid-column>
        <e-grid-column field="id" isPrimaryKey="true" visible="false"></e-grid-column>
        <e-grid-column field="code" headerText="Code" width="110"></e-grid-column>
        <e-grid-column field="name" headerText="Name" width="200"></e-grid-column>
        <e-grid-column field="active" headerText="Ενεργό" width="80" textAlign="Center"
                       displayAsCheckBox="true" type="boolean"></e-grid-column>
        <e-grid-column field="daysOverdue" headerText="Days Overdue" width="100" textAlign="Right"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="autoPayoffWayText" headerText="Auto Payoff" width="120"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="cfAccountName" headerText="Cash Flow Account" width="170"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="payoffSeriesName" headerText="Payoff Series" width="170"
                       hideAtMedia="(min-width: 768px)"></e-grid-column>
        <e-grid-column field="companyCode" headerText="Company" width="90"></e-grid-column>
        <e-grid-column headerText="" width="110" textAlign="Center" allowSorting="false"
                       template="#actionsTemplate"></e-grid-column>
    </e-grid-columns>
</ejs-grid>

<script id="actionsTemplate" type="text/x-template">
    <a href="@Url.Page("./Edit")?id=${id}" title="Edit"><i class="fas fa-edit fa-lg" style="color:slategray"></i></a>
    <a href="@Url.Page("./Details")?id=${id}" title="Details" class="ms-2"><i class="fas fa-info-circle fa-lg" style="color:slategray"></i></a>
    <a href="@Url.Page("./Delete")?id=${id}" title="Delete" class="ms-2"><i class="fas fa-trash fa-lg" style="color:slategray"></i></a>
</script>

<partial name="_DeleteConfirmationPartial" />

@section Scripts
{
    <script src="https://cdn.syncfusion.com/ej2/dist/ej2.min.js"></script>
    <script src="~/js/sf-grid-fit.js" asp-append-version="true"></script>
    <script src="~/js/sf-index-page.js" asp-append-version="true"></script>
    <script>
        // Runs before <ejs-scripts>: defines the grid and filter handlers the markup names.
        const sfIdx = sfIndexPage.create({
            gridId: 'PaymentMethodsGrid',
            storageKey: 'PaymentMethodsIndexSf',
            defaults: { sortField: 'code', companyFilter: '0', activeFilter: '' },
            combos: [
                { id: 'CompanyFilter', key: 'companyFilter' },
                { id: 'ActiveFilter', key: 'activeFilter' }
            ],
            deleteUrl: '@Url.Page("./IndexSf", "DeleteSelected")',
            deleteNoun: 'payment method(s)',
            loadErrorText: 'Could not load the payment methods'
        });
    </script>
    <ejs-scripts></ejs-scripts>
    <script>
        document.addEventListener('DOMContentLoaded', () => sfIdx.start());
    </script>
}
