				const getSelectedCurrencyId = (selector, val) => {
					// Check if the value is null or undefined
					if (val == null) {
						// Find the first option element within the select
						let firstOption = selector.find('option:first');
						if (firstOption.length > 0) { // Check if a first option actually exists
							firstOption.prop('selected', true); // Select the first option
							val = selector.val(); // Get the value of the newly selected first option
							// Optional: If other parts of your code react to changes, trigger the change event
							// selector.trigger('change');
						} else {
							// Handle the case where the select element has no options
							console.warn("CurrencySelector select element has no options.");
							// Decide what curCurrencySelected should be in this case, e.g., NaN, 0, or null
							val = null;
						}
					}
					// Now, parse the value. Handle the case where val might still be null (if select was empty).
					let curCurrencySelected = val != null ? parseInt(val) : NaN;
					return curCurrencySelected;
				};
				const currencyChanged = () => {
					let selector = $('#CurrencySelector'); // Get the selector once for efficiency
					let val = selector.val(); // Get the current value
					let curCurrencySelected = getSelectedCurrencyId(selector, val);
					let currencyCode;
					try {
						let currentCurrency = currencyListJs.find(x => x.id === curCurrencySelected);
						currencyCode = currentCurrency.code;
						sessionObj.currencyCode = currencyCode;
						let locale = currentCurrency.displayLocale;
						formatterCurrency = new Intl.NumberFormat(locale,
							{
								style: 'currency',
								currency: currencyCode,
								minimumFractionDigits: 2
							});
						formatterNumber = new Intl.NumberFormat(locale,
							{
								maximumFractionDigits: 3

							});
						let cCulture = locale;
						let cBaseCulture = cCulture;
