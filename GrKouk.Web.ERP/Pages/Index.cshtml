@section Scripts
{
	<script src="~/lib/hotkeys/dist/hotkeys.js"></script>
	<script src="~/js/filterManagement.lib.js"></script>
	<script src="~/js/product.lib.js"></script>
	<partial name="Shared/_JsSyncfusionBlockPartial"/>
	<script>
		$(document).ready(function () {
			const storageKey = 'MainInfoPageNew';
			const elementSettingsConfig = {
				// Element ID: { key: storageKey, default: defaultValue, prop: propertyToSetOrRead }
				'DatePeriodFilter': {key: 'dateRangeFilter', default: 'CURYEAR', prop: 'value'},
				'CurrencySelector': {key: 'currentCurrency', default: 1, prop: 'value'},
				//'CompanyFilter':             { key: 'companyFilter',             default: 0,           prop: 'value' },
				'CompaniesFilter': {key: 'companiesFilter', default: '[0]', prop: 'value', dataType: 'array'},
				'fromDateFilterEl': {key: 'fromDateFilter', default: '', prop: 'value'},
				'toDateFilterEl': {key: 'toDateFilter', default: '', prop: 'value'},
			};
			window.addEventListener('beforeunload', function (event) {
				console.log('beforeunload event triggered. Saving settings...'); // For debugging
				fltManLib.saveSettingsToStorage(storageKey, elementSettingsConfig);
				// DO NOT try to add confirmation dialogs or complex logic here.
			});
			const $currencySelector = $('#CurrencySelector');
			const $periodSelector = $('#DatePeriodFilter');
			const allCompaniesId = @ViewBag.AllCompaniesId;
			let currentCulture = '@System.Globalization.CultureInfo.CurrentCulture';

			let formatterCurrency = new Intl.NumberFormat(currentCulture,
				{
					style: 'currency',
					currency: 'EUR',
					minimumFractionDigits: 2
				});
			let formatterNumber = new Intl.NumberFormat(currentCulture,
				{
					maximumFractionDigits: 3

				});
			const currencyListJs = @Html.Raw(Json.Serialize(ViewBag.CurrencyListJs));
			//const companyListJs = @Html.Raw(Json.Serialize(ViewBag.CompanyListJs));
			//const datePeriodListJs = @Html.Raw(Json.Serialize(ViewBag.DatePeriodListJs));
			const computeLineSum = (dependentCodes) => {

			};
			//-----------------
			const selectedCompanies = document.getElementById("CompaniesFilterElm").ej2_instances[0];
			let companiesFilterValue = $('#CompaniesFilter').val();
			if (companiesFilterValue != null && companiesFilterValue.length > 0) {
				selectedCompanies.value = JSON.parse(companiesFilterValue);
			}
			selectedCompanies.changeOnBlur = false;
			selectedCompanies.addEventListener("change", (event) => {
				let a = allCompaniesId;
				// Ensure we have arrays, even if null/undefined
				const newValue = event.value || [];
				const oldValue = event.oldValue || []; // Assumes your component provides oldValue

				const zeroWasSelected = oldValue.includes(allCompaniesId);
				const zeroIsSelected = newValue.includes(allCompaniesId);

				let finalValue; // This will hold the calculated correct selection

				// --- Rule 1: User just selected 0 ---
				// Check if 0 is newly added in this change event
				if (zeroIsSelected && !zeroWasSelected) {
					finalValue = [allCompaniesId]; // Force selection to be only 0
				}
					// --- Rule 2: User selected something else while 0 was selected ---
				// Check if 0 was selected before, AND a non-zero item was added
				else if (zeroWasSelected) {
					// Find items present in newValue but not in oldValue
					const addedItems = newValue.filter(item => !oldValue.includes(item));
					// Check if any of those newly added items are not 0
					const addedNonZeroItem = addedItems.some(item => item !== allCompaniesId);

					if (addedNonZeroItem) {
						// User added a non-zero item while 0 was selected. Remove 0.
						finalValue = newValue.filter(item => item !== allCompaniesId);
					} else {
						// 0 was selected, but only other changes happened (like removing items, or removing 0 itself).
						// In this case, the component's newValue is likely correct as is (it might be just [0], or [] etc.)
						finalValue = newValue;
					}
				}
				// --- Default Case: No special 0-rule applies ---
				else {
					// 0 wasn't selected before, and wasn't added now. Normal selection.
					finalValue = newValue;
				}

				// --- Update Component and Hidden Field ---

				// Get the component's current visual value (might differ from finalValue if we intervened)
				const currentComponentValue = selectedCompanies.value || [];

				// Check if our calculated finalValue is different from the component's current value
				// Simple array comparison for primitive values:
				const valuesAreEqual = finalValue.length === currentComponentValue.length &&
					finalValue.every((val, index) => val === currentComponentValue[index]);

				// Only update the component's value if it needs changing, prevents potential event loops
				if (!valuesAreEqual) {
					selectedCompanies.value = finalValue;
				}

				// Always update the hidden input field with the final calculated value
				$('#CompaniesFilter').val(JSON.stringify(finalValue));
			});
			selectedCompanies.addEventListener("close", (event) => {
				refreshView();
				
			});

			//-----------------
			const refreshView = () => {

				let selPeriodId = $periodSelector.val();
				let selCurrencyId = $currencySelector.val();
				let selCompanies;
				let companiesFilterValue = $('#CompaniesFilter').val();
				if (companiesFilterValue != null && companiesFilterValue.length > 0) {
					selCompanies = companiesFilterValue;
				}

				let $expenseFieldsToCompute = $('[name=BuyCodeValue]');
				$expenseFieldsToCompute.each(function (index) {

					let $item = $(this);

					let cd = $item.data('computecode');
					let loader = $item.next();
					getFinancialData(cd, selPeriodId, selCompanies, selCurrencyId, $item, loader);

				});

				let $incomeFieldsToCompute = $('[name=SellCodeValue]');
				$incomeFieldsToCompute.each(function (index) {

					let $item = $(this);

					let cd = $item.data('computecode');
					let loader = $item.next();
					getFinancialData(cd, selPeriodId, selCompanies, selCurrencyId, $item, loader);

				});

				let $avgSellFieldsToCompute = $('[name=AvgSellCodeValue]');
				$avgSellFieldsToCompute.each(function (index) {

					let $item = $(this);

					let cd = $item.data('computecode');
					let loader = $item.next();
					getFinancialData(cd, selPeriodId, selCompanies, selCurrencyId, $item, loader);

				});

				let $avgBuyFieldsToCompute = $('[name=AvgBuyCodeValue]');
				$avgBuyFieldsToCompute.each(function (index) {

					let $item = $(this);

					let cd = $item.data('computecode');
					let loader = $item.next();
					getFinancialData(cd, selPeriodId, selCompanies, selCurrencyId, $item, loader);

				});
				//updateBalanceGroup();

			};
			//-------------Autocomplete shortcuts modal--------------------
			const refreshAutoCompleteData = (e) => {

				let term = e.text;
				//let selCompanyId = $companyId.val();
				//let selSeriesId = $transDocSeriesId.val();

				if (!term || term.trim() === "") {
					return;
				}
				let uri = "/api/autocomplete/GetShortcutsAutoCompleteData";
				uri += `?term=${term}`;
				//uri += `?companyId=${selCompanyId}`;
				//uri += `&seriesId=${selSeriesId}`;
				//uri += `&term=${term}`;
				productLib.makeAjaxCallGet(uri)
					.then((data) => {
						e.updateData(data.result, null);
					})
					.catch((error) => {
						console.log("Error in ajax call");
					});


			};
			const setUpAutoComplete = () => {
				let autoCompleteEL = document.getElementById("ShortCutsAutoComplete").ej2_instances[0];
				let debounceTimeout;
				autoCompleteEL.addEventListener("filtering", (e) => {
					//console.log("******Inside filtering event listener");
					clearTimeout(debounceTimeout);
					debounceTimeout = setTimeout(() => {
						refreshAutoCompleteData(e);
					}, 1000);
				});
				//autocompleteel . text ---> text of selected element
				//autocompleteel . value ---> id of  selected element
			};
			//-------------------------------------------------------------
			
			
			
			//--------------------------------------------------------------------------
			const getFinancialData = (codeToCompute, dateRange, selCompany, selCurrency, element, loader, selectionCallback) => {
				//console.log('Inside getFinancialData')
				var timeout;
				var uri = '/api/FinancialData/GetMainDashboardInfo?';
				uri += `codeToCompute=${codeToCompute}`;
				uri += `&companyFilter=${selCompany}`;
				uri += `&dateRange=${dateRange}`;
				uri += `&displayCurrencyId=${selCurrency}`;
				$.ajax({
					contentType: 'application/json; charset=utf-8',
					dataType: 'json',
					type: 'GET',
					url: uri,
					beforeSend: function () {
						if (loader) {
							if (timeout) {
								clearTimeout(timeout);
							}
							timeout = setTimeout(function () {
									loader.show();

								},
								1000);
						}
					},
					success: function (result) {

						let vlVal = parseFloat(result.requestedCodeSum);
						let vl = formatterCurrency.format(result.requestedCodeSum);
						element.text(vl);
						element.attr('value', vlVal);
						let $balanceFieldsToUpdate = $('[name=BalanceCodeValue]');
						$balanceFieldsToUpdate.each(function (index) {
							let $item = $(this);
							let cd = $item.data('dependsoncodes');

							if (cd.includes(codeToCompute)) {
								// console.log(`Storing for code ${codeToCompute} value ${vlVal}`);
								if (codeToCompute.includes('Buys')) {
									$item.data('buyvalue', vlVal);
									$item.attr('buyvalue', vlVal);
								}
								if (codeToCompute.includes('Sales')) {
									$item.data('sellvalue', vlVal);
									$item.attr('sellvalue', vlVal);
								}
							}
						});
						updateSumForGroup(element);
						updateBalanceGroup();
					},
					complete: function () {
						if (loader) {
							if (timeout) {
								clearTimeout(timeout);
							}
							setTimeout(function () {
									var isOpen = loader.is(':visible');
									if (isOpen) {
										loader.hide();
									} else {
										console.log('No open modal');
									}
								},
								2000);
						}

					},
					error: function (e) {
						console.log(e);

					}
				});
			};
			const updateBalanceGroup = () => {
				//console.log('Inside updateBalanceGroup');
				let $balanceFieldsToCompute = $('[name=BalanceCodeValue]');
				let sumOfBalance = parseFloat('0');
				$balanceFieldsToCompute.each(function (index) {
					let $item = $(this);
					//console.log($item.data('dependsoncodes'));
					//let tbuyVal = $item.data('buyvalue');
					let tbuyVal = $item.attr('buyvalue');
					let buyVal = parseFloat('0');
					if (tbuyVal) {
						buyVal = parseFloat(tbuyVal);
					}

					//let tSellVal = $item.data('sellvalue');
					let tSellVal = $item.attr('sellvalue');
					let sellVal = parseFloat('0');
					if (tSellVal) {
						sellVal = parseFloat(tSellVal);
					}


					let difVal = sellVal - buyVal;
					sumOfBalance += difVal;
					$item.text(formatterCurrency.format(difVal));
				});
				$('#BalanceSumValue').text(formatterCurrency.format(sumOfBalance));
