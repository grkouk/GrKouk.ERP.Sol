<!-- Modal -->
<div class="modal fade" id="customDateFilter" tabindex="-1" aria-labelledby="customDateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customDateModalLabel">Seleect Custom Dates</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="fromDateFilterEl">From date:</label>
                <input type="date" id="fromDateFilterEl"/>
                <label for="toDateFilterEl">To date:</label>
                <input type="date" id="toDateFilterEl"/>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="customDatesSelected">Select Period</button>
            </div>
        </div>
    </div>
</div>