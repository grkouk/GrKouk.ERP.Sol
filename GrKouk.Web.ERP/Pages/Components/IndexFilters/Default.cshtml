@using GrKouk.Web.ERP.Helpers
@model GrKouk.Web.ERP.Helpers.IndexFilterResult

@{
    var viewContext = (ViewContext)ViewData["ViewContext"];
    var script = @"
        <script>
        $(document).ready(function () {
             document.getElementById('DatePeriodFilter').addEventListener('change', dateFilterValueChange, true);
             function dateFilterValueChange(e) {
                 if (e.currentTarget.value === 'CUSTOM') {
                     e.preventDefault();
                     e.stopPropagation();
                     var myModal = new bootstrap.Modal(document.getElementById('customDateFilter'), {
                         keyboard: true, focus: true
                     });
                     myModal.show();
                 } else {
                     return;
                 }
             }
             let selectButtonEl = document.getElementById('customDatesSelected');
             document.getElementById('customDatesSelected').addEventListener('click', dateFilterCustomDatesSelected, true);
             function dateFilterCustomDatesSelected(e) {
                      $('#customDateFilter').modal('hide');
                      indPgLib.refreshData();
             }
            let toDateFilterValue=new Date();
            let fromDateFilterValue = new Date(toDateFilterValue.getFullYear(),toDateFilterValue.getMonth()-1,1);
            const elemFrom = document.getElementById(""fromDateFilterEl"");
            const elemTo = document.getElementById(""toDateFilterEl"");
            const fromDateString = fromDateFilterValue.toJSON().slice(0, 10);
            elemFrom.value = fromDateString;
            toDateString = toDateFilterValue.toJSON().slice(0, 10);
            elemTo.value = toDateString;
        });
         </script>
                 ";
    ScriptHelper.AddScript(viewContext, script);
}
@{
    Layout = null;
}


<style>
  
</style>
<div class="collapse show" id="filterCollapse">
    <form class="form-inline" id="FiltersForm" method="get">
        <input type="hidden" id="filtersVisible" />
        <input type="hidden" id="rowSelectorsVisible" />
        <input type="hidden" id="currentSort" />
        <input type="hidden" id="currentFilter" />
        <input type="hidden" id="totalPages" />
        <input type="hidden" id="totalRecords" />
        <input type="hidden" id="pageIndex" />
        <input type="hidden" id="SectionsFilter" />
        
        <div class="row align-items-center">
            <div class="col-md-auto">
                <div class="searchbar">
                    <input class="search_input" type="text" name="" placeholder="Search...">
                    <a href="#" class="search_icon">
                        <i class="fas fa-search fa-xs"></i>
                    </a>
                </div>
            </div>
            @{
                if (Model.FiltersToShow.ShowDateFlt)
                {
                    <div class="col-md-2 col-sm-6 col-lg-2">

                        <div class="form-floating">

                            <select name="DatePeriodFilter" id="DatePeriodFilter" class="form-select form-select-sm"
                                    asp-items="Model.DateFilterValues">
                            </select>
                            <label id="datePeriodLabel" class="small">Period:</label>
                        </div>

                    </div>
                    
                }

            }
            @{
                if (Model.FiltersToShow.ShowMaterialNatureFlt)
                {
                    <div class="col-md-2 col-sm-6 col-lg-2">
                        <div class="form-floating">
                            <select id="WarehouseItemNatureFilter" class="form-select form-select-sm"
                                    asp-items="Model.MaterialNaturesFilterValues">
                            </select>
                            <label class="small">Material Nature:</label>
                        </div>

                    </div>
                }

            }
            @{
                if (Model.FiltersToShow.ShowMaterialCategoriesFlt)
                {
                    <div class="col-md-2 col-sm-6 col-lg-2">
                        <div class="form-floating">
                            <select id="MaterialCategoriesFilter" class="form-select form-select-sm"
                                    asp-items="Model.MaterialCategoriesFilterValues">
                            </select>
                            <label class="small">Material Categories:</label>
                        </div>

                    </div>
                }

            }
            @{
                if (Model.FiltersToShow.ShowTransactorTypeFlt)
                {
                    <div class="col-md-2 col-sm-6 col-lg-2">
                        <div class="form-floating">
                            <select id="TransactorTypeFilter" class="form-select form-select-sm"
                                    asp-items="Model.TransactorTypeFilterValues">
                            </select>
                            <label class="small">Transactor Type:</label>
                        </div>

                    </div>
                }

            }
          
            @{
                if (Model.FiltersToShow.ShowSectionsFlt)
                {
                    <div class="col-md-3 col-sm-6 col-lg-3">
                      <ejs-multiselect id="SectionsFilterElm" dataSource="@Model.SectionsFilterUiSelectItems" placeholder="Sections" mode="CheckBox"
                                         showDropDownIcon="true"
                                         floatLabelType="Auto"
                                         allowResize ="true"
                                         showSelectAll="false">
                            <e-multiselect-fields text="Text" value="ValueInt"></e-multiselect-fields>
                        </ejs-multiselect>
                      </div>
                }

            }
            @{
                if (Model.FiltersToShow.ShowCompaniesFlt)
                {
                    <div class="col-md-2 col-sm-6 col-lg-2">
                        <div class="form-floating">
                            <select id="CompanyFilter" class="form-select form-select-sm" asp-items="Model.CompanyFilterValues">
                            </select>
                            <label class="small">Company:</label>
                        </div>

                    </div>
                }

            }
            @{
                if (Model.FiltersToShow.ShowPageSizeFlt)
                {
                    <div class="col-md-2 col-sm-6 col col-lg-2">
                        <div class="form-floating">

                            <select id="PageSize" class="form-select form-select-sm" asp-items="Model.PageSizeFilterValues">
                            </select>
                            <label class="small"> Page:</label>
                        </div>
                    </div>
                }

            }
            @{
                if (Model.FiltersToShow.ShowCurrencyFlt)
                {
                    <div class="col-md-2 col-sm-6 col-lg-2">
                        <div class="form-floating">

                            <select id="CurrencySelector" class="form-select form-select-sm"
                                    asp-items="Model.CurrencyFilterValues">
                            </select>
                            <label class="small"> Currency:</label>
                        </div>
                    </div>
                }

            }
            @{
                if (Model.FiltersToShow.ShowDisplayCarryOnLineFlt)
                {
                    <div class="form-check form-switch col-md-1 col-sm-6">
                        <input class="form-check-input" type="checkbox" id="ShowCarryOnFlt">
                        <label class="form-check-label" for="ShowCarryOnFlt">Carry Ons</label>
                    </div>

                }

            }

            @{
                if (Model.FiltersToShow.ShowDisplaySummaryFlt)
                {
                    <div class="form-check form-switch col-md-1 col-sm-6">
                        <input class="form-check-input" type="checkbox" id="ShowSummaryFlt">
                        <label class="form-check-label" for="ShowSummaryFlt">Summary</label>
                    </div>

                }

            }
            @{
                if (Model.FiltersToShow.ShowDisplayLinesWithZeroAmountFlt){
                    <div class="form-check form-switch col-md-1 col-sm-6">
                        <input class="form-check-input" type="checkbox" id="ShowDisplayLinesWithZeroes">
                        <label class="form-check-label" for="ShowDisplayLinesWithZeroes">Show Zeroes</label>
                    </div>
                }
            }
        </div>


    </form>
</div>

<!-- Custom Date filter Modal -->
<div class="modal fade" id="customDateFilter" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel"
     aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label for="fromDateFilterEl">From date:</label>
                <input type="date" id="fromDateFilterEl"/>
                <label for="toDateFilterEl">To date:</label>
                <input type="date" id="toDateFilterEl"/>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="customDatesSelected">Select Period</button>
            </div>
        </div>
    </div>
</div>